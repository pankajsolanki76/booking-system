generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HealthCheck {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
  THEATER_MANAGER
  TICKET_SCANNER
}

enum WaitlistStatus {
  PENDING
  NOTIFIED
  COMPLETED
  EXPIRED
}

enum SeatStatus {
  AVAILABLE
  LOCKED
  BOOKED
}

enum SeatType {
  REGULAR
  PREMIUM
  VIP
  LOUNGER
  RECLINER
  WHEELCHAIR
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model User {
  id          String @id @default(cuid())
  name        String
  email       String @unique
  phoneNumber String @unique
  password    String
  role        Role   @default(USER)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings   Booking[]
  userVenues UserVenue[]
  waitlists  Waitlist[]
  reviews    Review[]

  @@index([email])
  @@index([phoneNumber])
  @@index([isDeleted])
}

model Booking {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  showId String
  show   Show   @relation(fields: [showId], references: [id])

  baseAmount     Decimal @db.Decimal(10, 2)
  taxes          Decimal @db.Decimal(10, 2)
  convenienceFee Decimal @db.Decimal(10, 2)
  totalAmount    Decimal @db.Decimal(10, 2)

  bookingStatus BookingStatus @default(PENDING)

  paymentStatus PaymentStatus @default(PENDING)

  expiresAt DateTime

  confirmedAt DateTime?
  checkedInAt DateTime?

  payment Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingSeats BookingSeat[]

  @@index([userId])
  @@index([showId])
  @@index([bookingStatus])
}

model Category {
  id String @id @default(cuid())

  name String
  slug String

  description String?

  isDeleted Boolean @default(false)

  deletedAt DateTime?

  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, isDeleted])
  @@unique([slug, isDeleted])
  @@index([name])
  @@index([slug])
  @@index([isDeleted])
}

model Event {
  id String @id @default(cuid())

  title String

  slug String

  description String?

  language String?

  durationMins Int?

  posterUrl String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  isDeleted Boolean @default(false)

  deletedAt DateTime?

  shows   Show[]
  reviews Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug, isDeleted])
  @@unique([title, isDeleted])
  @@index([title])
  @@index([categoryId])
  @@index([isDeleted])
}

model Show {
  id String @id @default(cuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  screenId String
  screen   Screen @relation(fields: [screenId], references: [id])

  startTime DateTime
  endTime   DateTime

  availableSeats Int

  isDeleted Boolean @default(false)

  deletedAt DateTime?

  showSeats ShowSeat[]

  bookings  Booking[]
  waitlists Waitlist[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([screenId])
  @@index([startTime])
  @@index([isDeleted])
}

model Venue {
  id String @id @default(cuid())

  name String

  slug String

  address String

  city String

  isDeleted Boolean @default(false)

  deletedAt DateTime?

  screens  Screen[]
  managers UserVenue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, isDeleted])
  @@unique([slug, isDeleted])
  @@index([city])
  @@index([name])
  @@index([isDeleted])
}

model Screen {
  id String @id @default(cuid())

  name String

  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  totalSeats Int

  shows Show[]
  seats ScreenSeat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
}

model ScreenSeat {
  id String @id @default(cuid())

  screenId String
  screen   Screen @relation(fields: [screenId], references: [id])

  seatNumber Int

  rowLabel String

  price Decimal @db.Decimal(10, 2)

  gridRow Int?

  gridCol Int?

  type SeatType @default(REGULAR)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  showSeats ShowSeat[]

  @@unique([screenId, rowLabel, seatNumber])
  @@index([screenId])
  @@index([isActive])
}

model ShowSeat {
  id String @id @default(cuid())

  showId String
  show   Show   @relation(fields: [showId], references: [id])

  screenSeatId String
  screenSeat   ScreenSeat @relation(fields: [screenSeatId], references: [id])

  status SeatStatus @default(AVAILABLE)

  price Decimal @db.Decimal(10, 2)

  lockedAt DateTime?

  lockedUntil DateTime?

  bookedAt     DateTime?
  bookingSeats BookingSeat[]
  history      ShowSeatHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([showId, screenSeatId])
  @@index([showId])
  @@index([status])
}

model ShowSeatHistory {
  id         String      @id @default(cuid())
  showSeatId String
  showSeat   ShowSeat    @relation(fields: [showSeatId], references: [id])
  oldStatus  SeatStatus?
  newStatus  SeatStatus
  changedBy  String?
  changedAt  DateTime    @default(now())

  @@index([showSeatId])
  @@index([changedAt])
}

model BookingSeat {
  id String @id @default(cuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  showSeatId String
  showSeat   ShowSeat @relation(fields: [showSeatId], references: [id])

  price Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@unique([bookingId, showSeatId])
  @@index([showSeatId])
}

model Payment {
  id String @id @default(cuid())

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id])

  amount Decimal @db.Decimal(10, 2)

  status PaymentStatus

  transactionRef String?

  paidAt DateTime?

  createdAt DateTime @default(now())

  @@index([status])
}

model UserVenue {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, venueId])
  @@index([userId])
  @@index([venueId])
}

model Waitlist {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  showId String
  show   Show   @relation(fields: [showId], references: [id])

  status WaitlistStatus @default(PENDING)

  notifiedAt     DateTime?
  claimExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, showId])
  @@index([showId])
  @@index([status])
}

model Review {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  rating  Int
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, eventId])
  @@index([eventId])
  @@index([rating])
}
